OPENAI_API_KEY=sk-...

# Where data is saved. Leave MONGODB_URI unset to save everything in each user's browser (no database needed).
# Set it to switch to MongoDB storage.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pantry-chef?retryWrites=true&w=majority
# Optional: force a mode regardless of MONGODB_URI (browser | mongo)
# STORAGE=browser

PORT=5000
# Optional overrides
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# low | medium | high
OPENAI_IMAGE_QUALITY=medium
